rules_version = '2';
// Each explorer can only read and write their own documents.
// The leaderboard is opt-in: signed-in explorers can read it, and each can only write their own entry.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /photos/{photoId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      }
    }
    // Place suggestions: any signed-in explorer can send one and see their own; only admins review them.
    function isAdmin() { return request.auth != null && request.auth.uid in ['mFVncZECD1RUTTblTNfoEhIgY2M2']; }
    match /suggestions/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.place is string && request.resource.data.place.size() > 0 && request.resource.data.place.size() <= 80
        && request.resource.data.why is string && request.resource.data.why.size() <= 600
        && request.resource.data.cat in ['gor', 'ye', 'dene'] && request.resource.data.ll is list && request.resource.data.ll.size() == 2;
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.xp is number && request.resource.data.level is number
        && request.resource.data.name is string && request.resource.data.name.size() <= 24;
    }
  }
}
